---
import '../layouts/style.css';
import Navigation from "../components/Navigation.astro";
import DevblogsContainer from "../components/DevblogsContainer.jsx"
import { getCollection, getEntry } from 'astro:content';

import type { MarkdownInstance } from 'astro';
// interface Frontmatter {
//     title: string;
//     description?: string;
// }

// const posts = Object.values(import.meta.glob<MarkdownInstance<Frontmatter>>('../content/*.md', { eager: true }));

  const allBlogPosts = await getCollection("devblog")
---
<head>
    <meta charset="UTF-8">
    <title>Chris's Devlog</title>
</head>
<body>
<div>
    <Navigation />
    <div>
        <ul>
        {allBlogPosts.map(post => (
            <li><a href={`/devblogs/${post.id}`}>{post.data.title}{post.id}</a></li>
        ))}
        </ul>
    </div>
</div>
</body>
